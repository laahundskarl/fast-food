generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider          = "mysql"
    url               = env("DATABASE_URL")
    shadowDatabaseUrl = env("MIGRATE_DATABASE_URL")
}

model Client {
    id    String @id @default(uuid())
    name  String @db.VarChar(255)
    cpf   String @unique @db.VarChar(11)
    email String @unique @db.VarChar(255)

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    orders Order[]

    @@map("client")
}

model Order {
    id          String      @id @default(uuid())
    clientId    String?     @map("client_id") @db.Char(36)
    value       Int
    orderNumber Int         @unique @default(autoincrement()) @map("order_number")
    status      OrderStatus @default(WAITING)

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    client        Client?        @relation(fields: [clientId], references: [id])
    orderProducts OrderProduct[]
    payments      Payment[]

    @@map("order")
}

model OrderProduct {
    id        String @id @default(uuid())
    orderId   String @map("order_id") @db.Char(36)
    productId String @map("product_id") @db.Char(36)
    amount    Int
    value     Int

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    order   Order   @relation(fields: [orderId], references: [id])
    product Product @relation(fields: [productId], references: [id])

    @@map("order_product")
}

model Payment {
    id                String        @id @default(uuid())
    orderId           String        @map("order_id") @db.Char(36)
    status            StatusPayment @default(PENDING)
    externalReference String?       @map("external_reference") @db.VarChar(100)
    qrCode            String?       @map("qr_code")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    order Order @relation(fields: [orderId], references: [id])

    @@map("payment")
}

model ProductCategory {
    id   String @id @default(uuid())
    name String @db.VarChar(255)

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    products Product[]

    @@map("product_category")
}

model Product {
    id          String  @id @default(uuid())
    name        String  @db.VarChar(255)
    value       Int
    description String? @db.VarChar(500)
    categoryId  String  @map("category_id") @db.Char(36)

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    category      ProductCategory @relation(fields: [categoryId], references: [id])
    orderProducts OrderProduct[]

    @@map("product")
}

enum OrderStatus {
    WAITING
    IN_PROGRESS
    READY
    CANCELED
}

enum StatusPayment {
    PENDING
    APPROVED
    REJECTED
}
